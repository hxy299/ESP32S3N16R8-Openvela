#
# NuttX defconfig — ESP32-S3-N16R8（芯路城开发板）
# 配置名：ble
#
# ## 本配置目标
#
# 在已验证的 `psram` 基线之上，**只加一件事：启用 BLE**。
# 目的是确认 ESP32-S3 的蓝牙控制器能在 NuttX 下初始化成功。
#
# ## 相对 defconfig.psram 的改动（全部来自官方 esp32s3-devkit:ble 的差异）
#
# 取自 `boards/xtensa/esp32s3/esp32s3-devkit/configs/ble/defconfig` 相对
# 同板 `nsh` 的 diff，逐项说明：
#
#   1. CONFIG_ESP32S3_BLE=y
#      ★ 核心。芯片侧 BLE 控制器开关。
#      它 `select ESP32S3_WIRELESS`，后者又 select NET / ARCH_PHY_INTERRUPT /
#      ESP32S3_RNG / ESP32S3_RT_TIMER / ESP32S3_TIMER0。
#
#   2. CONFIG_WIRELESS=y + CONFIG_WIRELESS_BLUETOOTH=y
#      NuttX 通用 wireless 层 + BLE host 协议栈开关。
#      host 栈实现在 nuttx/wireless/bluetooth/（bt_hcicore/bt_l2cap/bt_att/
#      bt_gatt/bt_smp/bt_conn 等）。
#
#   3. CONFIG_DRIVERS_BLUETOOTH=y + CONFIG_DRIVERS_WIRELESS=y
#      + CONFIG_DRIVERS_IEEE80211=y
#      驱动层注册（bt_driver_register 走这里）。
#
#   4. CONFIG_NET_BLUETOOTH=y
#      蓝牙 socket（AF_BLUETOOTH）支持。
#
#   5. CONFIG_ALLOW_BSD_COMPONENTS=y
#      BLE host 栈（Zephyr/Intel 血统）用到 BSD 组件，必须打开。
#
#   6. CONFIG_BTSAK=y + CONFIG_SYSTEM_ARGTABLE3=y
#      btsak 是 NuttX 的蓝牙命令行调试工具，**用来验证 BLE 是否工作**。
#      它依赖 argtable3 做命令行解析。
#
#   7. CONFIG_ESP32S3_RT_TIMER_TASK_STACK_SIZE=4096
#      无线子系统依赖的 RT 定时器任务栈加大。
#
#   8. 内存/栈相关（BLE 比纯 nsh 吃资源）
#      CONFIG_DEFAULT_TASK_STACKSIZE=4096
#      CONFIG_INIT_STACKSIZE=8192      （nsh 是 3072）
#      CONFIG_POSIX_SPAWN_DEFAULT_STACKSIZE=2048
#      CONFIG_PREALLOC_MQ_MSGS=32
#      CONFIG_PTHREAD_MUTEX_TYPES=y
#      CONFIG_SPINLOCK=y
#      CONFIG_TIMER=y
#      CONFIG_TLS_TASK_NELEM=4
#      CONFIG_FS_LARGEFILE=y
#      CONFIG_NAME_MAX=48
#      CONFIG_NETDEV_LATEINIT=y
#
#   9. 网络基础（BLE socket 需要）
#      CONFIG_NET_SOCKOPTS=y
#      CONFIG_NET_TCP=y
#      CONFIG_NET_ETH_PKTSIZE=1514
#
#  10. CONFIG_BOARDCTL_RESET=y
#      允许程序触发板级复位（btsak 与调试用得上）。
#
#  11. CONFIG_SIG_DEFAULT=y
#      默认信号行为。
#
# ## 保留自 psram 基线的项
#
#   - PSRAM 全套（8MB Octal，显式 ESPPSRAM64）—— BLE 协议栈吃内存，
#     有 PSRAM 更宽裕
#   - CONFIG_MM_REGIONS=2
#   - CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y
#   - 调试符号（CONFIG_DEBUG_SYMBOLS / DEBUG_FULLOPT）
#     注意：官方 ble 配置**关掉了**调试符号（因为它没设这两项），
#     我们保留，便于出问题时用 GDB 与 System.map 分析。
#
# ## ⚠️ 与 PSRAM 配置共同的注意点
#
# `esp32s3_start.c:395` 的 `ESP32S3_SPIRAM_IGNORE_NOTFOUND` 少了 CONFIG_ 前缀
# （上游 bug），PSRAM 初始化失败必然 PANIC，没有兜底。
#
# ## 验证方法
#
#   烧录后：
#     1. 启动日志无 PANIC，出现 nsh>
#     2. `free` 仍显示约 8.8MB（PSRAM 在）
#     3. `btsak` 能运行（蓝牙命令工具）
#     4. 用手机或 A7Z 扫描，应能发现名为 NuttX 的 BLE 设备
#        （广播名由 CONFIG_DEVICE_LOCAL_NAME / BLUETOOTH_NAME 决定）
#
# ## 构建
#
#   source ~/.openvela-proxy-env
#   bash scripts/build/build-n16r8.sh ble
#
# CONFIG_ARCH_LEDS is not set
# CONFIG_NDEBUG is not set
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ARCH="xtensa"
CONFIG_ARCH_BOARD="esp32s3-devkit"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32S3_DEVKIT=y
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_XTENSA=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LOOPSPERMSEC=16717
CONFIG_BTSAK=y
CONFIG_BUILTIN=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEFAULT_TASK_STACKSIZE=4096
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_ESP32S3_BLE=y
CONFIG_ESP32S3_RT_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP32S3_UART0=y
CONFIG_FS_LARGEFILE=y
CONFIG_FS_PROCFS=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_IDLETHREAD_STACKSIZE=3072
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=8192
CONFIG_INTELHEX_BINARY=y
CONFIG_LINE_MAX=64
CONFIG_NAME_MAX=48
CONFIG_NETDEV_LATEINIT=y
CONFIG_NET_BLUETOOTH=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_POSIX_SPAWN_DEFAULT_STACKSIZE=2048
CONFIG_PREALLOC_MQ_MSGS=32
CONFIG_PREALLOC_TIMERS=4
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RAM_SIZE=114688
CONFIG_RAM_START=0x20000000
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SIG_DEFAULT=y
CONFIG_SPINLOCK=y
CONFIG_START_DAY=6
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2011
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSTEM_ARGTABLE3=y
CONFIG_SYSTEM_NSH=y
CONFIG_TIMER=y
CONFIG_TLS_TASK_NELEM=4
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_BLUETOOTH=y
#
# ---- PSRAM（取自 defconfig.psram，BLE 协议栈吃内存，保留）----
#
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_ESP32S3_SPIRAM_BOOT_INIT=y
CONFIG_ESP32S3_SPIRAM_COMMON_HEAP=y
CONFIG_ESP32S3_SPIRAM_SPEED_40M=y
CONFIG_MM_REGIONS=2
