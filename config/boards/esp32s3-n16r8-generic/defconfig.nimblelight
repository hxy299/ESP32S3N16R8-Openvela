#
# NuttX defconfig — ESP32-S3-N16R8（芯路城开发板）
# 配置名：nimblelight
#
# ## 目标
#
# 在 defconfig.nimble（NimBLE host 已跑通）的基础上，
# 用本项目自己的 GATT 灯控应用替换 NimBLE 自带的残缺示例。
#
# ## 与 defconfig.nimble 的差异
#
#   1. CONFIG_NIMBLE_PORTING_EXAMPLE=n
#      -- 自带示例（porting/examples/nuttx/main.c）是残缺的：
#         从不启动广播、没设 ble_hs_cfg.sync_cb。
#         两个 main 同时编进固件会冲突，必须关掉。
#
#   2. CONFIG_BTSH_LIGHT_NIMBLE=y
#      -- 启用本项目自己的应用 apps/wireless/bluetooth/btsh_light_nimble/
#         NSH 命令名：nimble_light
#
# ## 判据
#
#   1. 启动无 PANIC
#   2. nsh> nimble_light  ->  GATT 服务注册 + 开始广播
#   3. 手机 nRF Connect 能扫到 BTSH-LIGHT
#   4. 连接后能列出 FF00 服务及 FF01/FF02/FF03 三个特征  <-- 决定性
#   5. 写 FF01 = 01 板载 RGB 变绿；写 00 熄灭
### 构建
#
#   source ~/.openvela-proxy-env
#   bash scripts/build/build-n16r8.sh nimble
#
# ## 判据
#
#   1. 启动无 PANIC，出现 nsh>
#   2. 手机能扫到设备
#   3. 连接不崩溃
#   4. ★ GATT 服务发现成功（列出自定义服务与特征）← 决定性
#   5. 写特征值能点亮板载 RGB
#
# CONFIG_ARCH_LEDS is not set
# CONFIG_NDEBUG is not set
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
# CONFIG_WIRELESS_BLUETOOTH_HOST is not set
# CONFIG_BTSAK is not set
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ARCH="xtensa"
CONFIG_ARCH_BOARD="esp32s3-devkit"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32S3_DEVKIT=y
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_XTENSA=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LOOPSPERMSEC=16717
CONFIG_BUILTIN=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEFAULT_TASK_STACKSIZE=4096
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_ESP32S3_BLE=y
CONFIG_ESP32S3_RT_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP32S3_SPI2=y
CONFIG_ESP32S3_SPI2_MOSIPIN=48
CONFIG_ESP32S3_UART0=y
CONFIG_EXAMPLES_WS2812=y
CONFIG_FS_LARGEFILE=y
CONFIG_FS_PROCFS=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_IDLETHREAD_STACKSIZE=3072
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=8192
CONFIG_INTELHEX_BINARY=y
CONFIG_LINE_MAX=64
CONFIG_NAME_MAX=48
CONFIG_NETDEV_LATEINIT=y
CONFIG_NET_BLUETOOTH=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NIMBLE=y
CONFIG_NIMBLE_BLE_VERSION_50=y
CONFIG_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_NIMBLE_ROLE_BROADCASTER=y
CONFIG_NIMBLE_TINYCRYPT=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_POSIX_SPAWN_DEFAULT_STACKSIZE=2048
CONFIG_PREALLOC_MQ_MSGS=32
CONFIG_PREALLOC_TIMERS=4
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RAM_SIZE=114688
CONFIG_RAM_START=0x20000000
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
# SIGEV_THREAD —— NimBLE 的 NuttX 移植层需要
#   porting/npl/nuttx/src/os_callout.c:105 用了 SIGEV_THREAD +
#   sigevent.sigev_notify_function / sigev_notify_attributes
#   不开启会报：'SIGEV_THREAD' undeclared
#   依赖：!BUILD_KERNEL && SCHED_WORKQUEUE（均已满足）
CONFIG_SIG_EVTHREAD=y
CONFIG_SIG_DEFAULT=y
CONFIG_SPINLOCK=y
CONFIG_START_DAY=6
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2011
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSTEM_NSH=y
CONFIG_TIMER=y
CONFIG_TLS_TASK_NELEM=4
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_BLUETOOTH=y
CONFIG_WS2812=y
CONFIG_WS2812_FREQUENCY=8000000
CONFIG_WS2812_LED_COUNT=1
#
# ---- PSRAM ----
#
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_ESP32S3_SPIRAM_BOOT_INIT=y
CONFIG_ESP32S3_SPIRAM_COMMON_HEAP=y
CONFIG_ESP32S3_SPIRAM_SPEED_40M=y
CONFIG_MM_REGIONS=2

#
# ---- 本项目应用：BLE GATT 灯控服务（NimBLE 版）----
#
# 关掉 NimBLE 自带示例：它的 main.c 残缺（从不启动广播、
# 没设 ble_hs_cfg.sync_cb），且与我们的 main 冲突。
CONFIG_NIMBLE_PORTING_EXAMPLE=y

CONFIG_BTSH_LIGHT_NIMBLE=y
CONFIG_BTSH_LIGHT_NIMBLE_PROGNAME="nimble_light"
CONFIG_BTSH_LIGHT_NIMBLE_PRIORITY=100
CONFIG_BTSH_LIGHT_NIMBLE_STACKSIZE=4096
CONFIG_BTSH_LIGHT_NIMBLE_ADV_NAME="BTSH-LIGHT"
CONFIG_BTSH_LIGHT_NIMBLE_LED_DEV="/dev/leds0"
#

#
# ---- SYSLOG 输出通道（必须）----
#
# 注意：CONFIG_SYSLOG_BUFFER=y 只是"开缓冲"，没有输出通道。
# 此时 syslog() 写入的缓冲区无人消费，写满后阻塞，
# 表现为：printf 的第一行能看到，之后整个 NSH 卡死。
#
# 实测现象（2026-10-11）：
#   nsh> nimble_light
#   BTSH: starting NimBLE light service...      <- printf，正常
#   （之后完全静默，state 子命令也无法执行 = NSH 阻塞）
#
# SYSLOG_CONSOLE 把日志送到 /dev/console（即串口），
# 与 printf 同一通道，问题消失。
#
CONFIG_SYSLOG_CONSOLE=y
