#
# NuttX defconfig — ESP32-S3-N16R8（芯路城开发板）
# 配置名：blewifi
#
# ## 本配置目标
#
# 在已验证的 `ble` 基线（BLE 广播端到端验证通过）之上，**加 WiFi**，
# 并要求 **WiFi 与 BLE 共存**（用户明确要求两者都支持）。
#
# ## 相对 defconfig.ble 的改动
#
# 全部取自官方 `esp32s3-devkit:blewifi` 相对同板 `ble` 的差异，
# 逐项说明：
#
#   1. CONFIG_ESP32S3_WIFI=y
#      ★ 芯片侧 WiFi 开关。
#
#   2. CONFIG_ESP32S3_WIFI_STATION_SOFTAP=y
#      同时支持 STA（连路由器）与 SoftAP（自建热点）。
#      对智能家居网关场景有用：既能连家里 WiFi，也能被直连配置。
#
#   3. CONFIG_WIRELESS_WAPI=y + CONFIG_WIRELESS_WAPI_CMDTOOL=y
#      + CONFIG_WIRELESS_WAPI_STACKSIZE=8192
#      NuttX 的 wapi 工具，用于扫描/连接 WiFi（`wapi` 命令）。
#
#   4. CONFIG_NETINIT_DHCPC=y + CONFIG_SYSTEM_DHCPC_RENEW=y
#      DHCP 客户端与续租，连上路由器后自动获取 IP。
#
#   5. CONFIG_NETUTILS_DHCPD=y + CONFIG_EXAMPLES_DHCPD=y
#      DHCP 服务端（SoftAP 模式下给其他设备分配 IP）。
#
#   6. CONFIG_NETDEV_WIRELESS_IOCTL=y + CONFIG_NETDEV_PHY_IOCTL=y
#      无线网卡的 ioctl 通路（wapi 与 ifconfig 依赖）。
#
#   7. CONFIG_NET_ICMP_SOCKET=y + CONFIG_SYSTEM_PING=y
#      ping 命令（验证网络连通性最直接的手段）。
#
#   8. CONFIG_NET_BROADCAST=y / CONFIG_NET_UDP=y / CONFIG_NET_UDP_WRITE_BUFFERS=y
#      + CONFIG_NET_TCP_DELAYED_ACK=y + CONFIG_NET_TCP_WRITE_BUFFERS=y
#      TCP/UDP 完整支持（DHCP、ping、未来的 MQTT/HTTP 都要）。
#
#   9. CONFIG_IOB_NBUFFERS=124 + CONFIG_IOB_THROTTLE=24
#      网络缓冲区数量。WiFi + BLE 并存时吞吐需求更大，官方把默认值提高了。
#
#  10. CONFIG_PREALLOC_MQ_MSGS=64
#      消息队列预分配（官方 ble 是 32，blewifi 提到 64）。
#
#  11. CONFIG_BLUETOOTH_TXCMD_PRIORITY=120 + CONFIG_BLUETOOTH_TXCONN_PRIORITY=119
#      ★ 共存关键：蓝牙 HCI 发送任务的优先级。
#      这两个值低于 WiFi 任务，确保 WiFi 优先，避免 BLE 抢占导致 WiFi 掉线。
#
#  12. CONFIG_BTSAK_STACKSIZE=8192
#      btsak 调试工具栈加大（共存时任务更多）。
#
#  13. CONFIG_MTD=y + CONFIG_MTD_BYTE_WRITE=y + CONFIG_MTD_PARTITION=y
#      + CONFIG_NETDB_DNSCLIENT=y + CONFIG_NETUTILS_CJSON=y
#      + CONFIG_NETUTILS_IPERF=y + CONFIG_EXAMPLES_RANDOM=y
#      + CONFIG_TLS_NELEM=4
#      官方 blewifi 带的配套组件（iperf 测吞吐、DNS 客户端、cJSON 等）。
#
# ## ★ 共存开关：CONFIG_ESP32S3_WIFI_BT_COEXIST
#
# 依据 `arch/xtensa/src/esp32s3/Kconfig:879-884`：
#
#     menuconfig ESP32S3_WIFI_BT_COEXIST
#         bool "Wi-Fi and BT coexist"
#         default y if ESP32S3_WIFI && ESP32S3_BLE      ← 默认就开
#         depends on ESP32S3_WIFI && ESP32S3_BLE
#         select ESP32S3_WIFI_STA_DISCONNECT_PM
#
# 即 WiFi 与 BLE 同时开启时它**默认 y**，无需在 defconfig 里显式写。
# 它 select 的 `ESP32S3_WIFI_STA_DISCONNECT_PM` 也是自动的。
#
# ## ⚠️ 构建时必须同时注入两个宏
#
# `esp-hal-3rdparty/nuttx/esp32s3/include/sdkconfig.h:1029`：
#
#     #if defined(CONFIG_ESPRESSIF_BLE) && defined(CONFIG_ESPRESSIF_WIFI)
#     #define CONFIG_ESP_COEX_SW_COEXIST_ENABLE 1        ← 软件共存
#     #endif
#
# 因此命令必须是（**两个都要**）：
#
#     ./build.sh <本配置> -e -DCONFIG_ESPRESSIF_BLE=1 \
#                         -e -DCONFIG_ESPRESSIF_WIFI=1 -j16
#
# 这与 BLE 单独构建时的缺口是同一个根因：`CONFIG_ESPRESSIF_BLE` 的 Kconfig
# 只在 RISC-V 侧存在（`arch/risc-v/src/common/espressif/Kconfig:505`），
# Xtensa 侧没有；`CONFIG_ESPRESSIF_WIFI` 同理（Xtensa 的同类 Kconfig 里
# 只有 `ESPRESSIF_WIFI` 而 sdkconfig.h 判的是 `CONFIG_ESPRESSIF_WIFI`）。
#
# ## 验证方法
#
#   1. 启动无 PANIC，出现 nsh>
#   2. `free` 仍约 8.7MB（PSRAM 在）
#   3. `ps` 里同时有 btController / BT_HCI_Tx / WiFi 相关任务
#   4. `ifconfig` 出现 WiFi 接口（wlan0 之类）
#   5. `wapi scan` 能扫到周围 WiFi（需实网）
#   6. `bt bnep0 advertise stop` → `start` 仍成功，且中央设备能扫到
#
# ## 构建
#
#   source ~/.openvela-proxy-env
#   bash scripts/build/build-n16r8.sh blewifi
#
# CONFIG_ARCH_LEDS is not set
# CONFIG_NDEBUG is not set
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ARCH="xtensa"
CONFIG_ARCH_BOARD="esp32s3-devkit"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32S3_DEVKIT=y
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_XTENSA=y
CONFIG_BLUETOOTH_TXCMD_PRIORITY=120
CONFIG_BLUETOOTH_TXCONN_PRIORITY=119
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LOOPSPERMSEC=16717
CONFIG_BTSAK=y
CONFIG_BTSAK_STACKSIZE=8192
CONFIG_BUILTIN=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEFAULT_TASK_STACKSIZE=4096
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_ESP32S3_BLE=y
CONFIG_ESP32S3_RT_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP32S3_UART0=y
CONFIG_ESP32S3_WIFI=y
CONFIG_ESP32S3_WIFI_STATION_SOFTAP=y
CONFIG_EXAMPLES_DHCPD=y
CONFIG_EXAMPLES_RANDOM=y
CONFIG_FS_LARGEFILE=y
CONFIG_FS_PROCFS=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_IDLETHREAD_STACKSIZE=3072
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=8192
CONFIG_INTELHEX_BINARY=y
CONFIG_IOB_NBUFFERS=124
CONFIG_IOB_THROTTLE=24
CONFIG_LINE_MAX=64
CONFIG_MTD=y
CONFIG_MTD_BYTE_WRITE=y
CONFIG_MTD_PARTITION=y
CONFIG_NAME_MAX=48
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_NETDEV_WIRELESS_IOCTL=y
CONFIG_NETINIT_DHCPC=y
CONFIG_NETUTILS_CJSON=y
CONFIG_NETUTILS_DHCPD=y
CONFIG_NETUTILS_IPERF=y
CONFIG_NET_BLUETOOTH=y
CONFIG_NET_BROADCAST=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NET_TCP_DELAYED_ACK=y
CONFIG_NET_TCP_WRITE_BUFFERS=y
CONFIG_NET_UDP=y
CONFIG_NET_UDP_WRITE_BUFFERS=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_POSIX_SPAWN_DEFAULT_STACKSIZE=2048
CONFIG_PREALLOC_MQ_MSGS=64
CONFIG_PREALLOC_TIMERS=4
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RAM_SIZE=114688
CONFIG_RAM_START=0x20000000
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SIG_DEFAULT=y
CONFIG_SPINLOCK=y
CONFIG_START_DAY=6
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2011
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSTEM_ARGTABLE3=y
CONFIG_SYSTEM_DHCPC_RENEW=y
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_PING=y
CONFIG_TIMER=y
CONFIG_TLS_NELEM=4
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_BLUETOOTH=y
CONFIG_WIRELESS_WAPI=y
CONFIG_WIRELESS_WAPI_CMDTOOL=y
CONFIG_WIRELESS_WAPI_STACKSIZE=8192
#
# ---- PSRAM（保留自 psram 基线；WiFi+BLE 共存更吃内存）----
#
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_ESP32S3_SPIRAM_BOOT_INIT=y
CONFIG_ESP32S3_SPIRAM_COMMON_HEAP=y
CONFIG_ESP32S3_SPIRAM_SPEED_40M=y
CONFIG_MM_REGIONS=2
