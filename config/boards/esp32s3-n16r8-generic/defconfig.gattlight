#
# NuttX defconfig — ESP32-S3-N16R8（芯路城开发板）
# 配置名：gattlight
#
# ## 本配置目标
#
# 在 `statusled` 基础上加入**本项目自写的 BLE GATT 灯控服务**，
# 这是项目第一阶段的交付目标：A7Z 上位机通过 BLE 远程控制下位机的灯。
#
# ## 相对 defconfig.statusled 的改动
#
#   1. CONFIG_BTSH_LIGHT=y
#      ★ 启用自写的 GATT 灯控服务应用（NSH 命令 `btsh_light`）。
#      该应用**不在上游 apps 里**，需先安装：
#        bash scripts/setup/install-btsh-light.sh
#      它注册自定义 GATT 服务 0xFF00：
#        0xFF01  灯控命令   WRITE          写 1 字节 0=关 1=开
#        0xFF02  灯状态     READ + NOTIFY  读 1 字节
#        0xFF03  设备信息   READ           读 3 字节（版本/通道数/保留）
#
#   2. CONFIG_BTSH_LIGHT_ADV_NAME="BTSH-LIGHT"
#      广播设备名（建议后续改成带 MAC 后缀，便于多设备辨认）。
#
#   3. CONFIG_BTSH_LIGHT_LED_DEV="/dev/leds0"
#      把"灯"先映射到板载 WS2812B，便于无外接硬件时验证 GATT 链路。
#      接继电器后改这里或改 btsh_light_apply() 的实现。
#
#   4. CONFIG_BTSH_LIGHT_STACKSIZE=4096
#      GATT 操作需要栈空间，4096 为设计值。
#
#   5. CONFIG_SYSTEM_SYSTEM=y + CONFIG_SYSTEM_NSH=y
#      常规 NSH 支持（已在基线里）。
#
# ## ⚠️ 为什么用 16 位 UUID
#
# NuttX 的 `BT_GATT_PRIMARY_SERVICE()` 宏内部把服务属性的 UUID 类型
# **硬编码为 `BT_UUID_16`**（见 bt_gatt.h:222-235），
# 因此当前实现**无法声明 128 位服务 UUID**。
# 本配置采用 16 位自定义 UUID 0xFF00 段，避开 Bluetooth SIG 常用分配。
#
# ## 构建
#
#   source ~/.openvela-proxy-env
#   bash scripts/setup/apply-board-ws2812.sh     # WS2812 板级支持（幂等）
#   bash scripts/setup/install-btsh-light.sh     # 安装 GATT 应用（幂等）
#   bash scripts/build/build-n16r8.sh gattlight
#
# ## 验证
#
#   板上：btsh_light start   -> 开始广播
#         btsh_light state   -> 查看状态
#   上位机（Windows/Python bleak 或 A7Z）：
#         扫描 -> 连接 -> 写 0xFF01 = 1 -> 板载 RGB 变绿
#                     写 0xFF01 = 0 -> 熄灭
#
# CONFIG_ARCH_LEDS is not set
# CONFIG_NDEBUG is not set
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ARCH="xtensa"
CONFIG_ARCH_BOARD="esp32s3-devkit"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32S3_DEVKIT=y
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_XTENSA=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LOOPSPERMSEC=16717
CONFIG_BTSAK=y
CONFIG_BTSH_LIGHT=y
CONFIG_BTSH_LIGHT_ADV_NAME="BTSH-LIGHT"
CONFIG_BTSH_LIGHT_LED_DEV="/dev/leds0"
CONFIG_BTSH_LIGHT_PRIORITY=100
CONFIG_BTSH_LIGHT_PROGNAME="btsh_light"
CONFIG_BTSH_LIGHT_STACKSIZE=4096
CONFIG_BUILTIN=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEFAULT_TASK_STACKSIZE=4096
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_ESP32S3_BLE=y
CONFIG_ESP32S3_RT_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP32S3_SPI2=y
CONFIG_ESP32S3_SPI2_MOSIPIN=48
CONFIG_ESP32S3_UART0=y
CONFIG_EXAMPLES_WS2812=y
CONFIG_FS_LARGEFILE=y
CONFIG_FS_PROCFS=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_IDLETHREAD_STACKSIZE=3072
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=8192
CONFIG_INTELHEX_BINARY=y
CONFIG_LINE_MAX=64
CONFIG_NAME_MAX=48
CONFIG_NETDEV_LATEINIT=y
CONFIG_NET_BLUETOOTH=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_POSIX_SPAWN_DEFAULT_STACKSIZE=2048
CONFIG_PREALLOC_MQ_MSGS=32
CONFIG_PREALLOC_TIMERS=4
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RAM_SIZE=114688
CONFIG_RAM_START=0x20000000
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SIG_DEFAULT=y
CONFIG_SPINLOCK=y
CONFIG_START_DAY=6
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2011
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSTEM_ARGTABLE3=y
CONFIG_SYSTEM_NSH=y
CONFIG_TIMER=y
CONFIG_TLS_TASK_NELEM=4
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_BLUETOOTH=y
CONFIG_WS2812=y
CONFIG_WS2812_FREQUENCY=8000000
CONFIG_WS2812_LED_COUNT=1
#
# ---- PSRAM（保留自 psram 基线）----
#
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_ESP32S3_SPIRAM_BOOT_INIT=y
CONFIG_ESP32S3_SPIRAM_COMMON_HEAP=y
CONFIG_ESP32S3_SPIRAM_SPEED_40M=y
CONFIG_MM_REGIONS=2
